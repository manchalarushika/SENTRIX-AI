# SENTRIX AI dashboard configuration (copy to frontend/.env)
# Backend the Vite dev server proxies /api and /ws to:
SENTRIX_BACKEND_URL=http://127.0.0.1:8000
# Optional: call a backend on another origin directly instead of the proxy
# (also add the dashboard origin to CORS_ORIGINS in backend/.env)
# VITE_API_URL=http://127.0.0.1:8000
