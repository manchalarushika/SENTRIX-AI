# ============================================================
# SENTRIX AI - backend configuration
# Copy to backend/.env and adjust. NEVER commit a real .env.
# Every value is optional; defaults are safe for local use.
# ============================================================

# --- Application ---------------------------------------------
APP_ENV=development            # development | production | test
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ------------------------------------------------
# Default: SQLite file backend/sentrix.db (created automatically)
# DATABASE_URL=sqlite:///./sentrix.db

# --- API security --------------------------------------------
# When set, POST/PUT/PATCH/DELETE require header  X-API-Key: <value>
# (in production, reads require it too). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# --- LLM (optional; used only for narrative analysis) --------
# none | openai | anthropic
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_SECONDS=30

# --- SOAR / ticketing webhook (optional) ---------------------
# Approved response actions are POSTed here as JSON. If empty,
# approved actions become manual tasks for an analyst.
SOAR_WEBHOOK_URL=
SOAR_WEBHOOK_TOKEN=

# --- Detection tuning ----------------------------------------
CORRELATION_WINDOW_MINUTES=60
ANOMALY_MIN_BASELINE_EVENTS=20
TWIN_SIMULATION_RUNS=300

# --- AI Council weights (relative) ---------------------------
COUNCIL_WEIGHT_ORACLE=1.3
COUNCIL_WEIGHT_BEHAVIOR=1.0
COUNCIL_WEIGHT_SENTINEL=1.1
COUNCIL_WEIGHT_GRAPH=1.0
COUNCIL_WEIGHT_TWIN=1.2
COUNCIL_WEIGHT_RISK=1.0
COUNCIL_WEIGHT_BUSINESS=0.9
COUNCIL_WEIGHT_INTEL=0.8
